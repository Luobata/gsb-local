#!/usr/bin/env bash
set -euo pipefail

SOURCE_PATH="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE_PATH" ]]; do
  SOURCE_DIR="$(cd "$(dirname "$SOURCE_PATH")" && pwd)"
  SOURCE_PATH="$(readlink "$SOURCE_PATH")"
  if [[ "$SOURCE_PATH" != /* ]]; then
    SOURCE_PATH="$SOURCE_DIR/$SOURCE_PATH"
  fi
done
ROOT_DIR="$(cd "$(dirname "$SOURCE_PATH")" && pwd)"

gsb_env_or_default() {
  local name="$1"
  local fallback="$2"
  local value="${!name:-}"
  printf '%s\n' "${value:-$fallback}"
}

gsb_socket_dir() {
  local cache_root
  if [[ -n "${GSB_SOCKET_DIR_OVERRIDE:-}" ]]; then
    printf '%s\n' "${GSB_SOCKET_DIR_OVERRIDE%/}"
  else
    cache_root="${XDG_CACHE_HOME:-$HOME/.cache}"
    printf '%s/gsb-zsock\n' "${cache_root%/}"
  fi
}

default_zellij_socket_dir() {
  local temp_root="${TMPDIR:-/tmp}"
  printf '%s/zellij-%s\n' "${temp_root%/}" "$(id -u)"
}

zellij_session_active_in() {
  local socket_dir="$1"
  local session="$2"
  local sessions
  if [[ -n "$socket_dir" ]]; then
    sessions="$(ZELLIJ_SOCKET_DIR="$socket_dir" zellij list-sessions --no-formatting 2>/dev/null || true)"
  else
    sessions="$(env -u ZELLIJ_SOCKET_DIR zellij list-sessions --no-formatting 2>/dev/null || true)"
  fi
  printf '%s\n' "$sessions" | awk -v session="$session" '$1 == session && !/EXITED/ { found = 1 } END { exit(found ? 0 : 1) }'
}

watchdog_zellij_session_active_in() {
  local socket_dir="$1"
  local session="$2"
  local sessions timeout_ms query_status=0
  timeout_ms="$(gsb_env_or_default GSB_WATCHDOG_ZELLIJ_TIMEOUT_MS 10000)"
  [[ "$timeout_ms" =~ ^[0-9]+$ && "$timeout_ms" -gt 0 ]] || timeout_ms=10000
  if [[ -n "$socket_dir" ]]; then
    sessions="$(ZELLIJ_SOCKET_DIR="$socket_dir" node "$ROOT_DIR/bin/zellij-timed.mjs" "$timeout_ms" list-sessions --no-formatting 2>/dev/null)" || query_status=$?
  else
    sessions="$(env -u ZELLIJ_SOCKET_DIR node "$ROOT_DIR/bin/zellij-timed.mjs" "$timeout_ms" list-sessions --no-formatting 2>/dev/null)" || query_status=$?
  fi
  (( query_status == 0 )) || return 2
  printf '%s\n' "$sessions" | awk -v session="$session" '$1 == session && !/EXITED/ { found = 1 } END { exit(found ? 0 : 1) }'
}

use_zellij_socket_dir() {
  if [[ -n "$1" ]]; then
    export ZELLIJ_SOCKET_DIR="$1"
  else
    unset ZELLIJ_SOCKET_DIR
  fi
}

session_socket_dir_from_env() {
  local env_file="$1"
  [[ -f "$env_file" ]] || return 0
  (
    unset ZELLIJ_SOCKET_DIR
    # Generated by gsb-local and sourced in an isolated subshell.
    source "$env_file"
    printf '%s' "${ZELLIJ_SOCKET_DIR:-}"
  )
}

validate_socket_path_length() {
  local socket_dir="$1"
  local session="$2"
  local socket_path="${socket_dir%/}/contract_version_1/$session"
  local socket_length
  socket_length="$(LC_ALL=C printf '%s' "$socket_path" | wc -c | tr -d '[:space:]')"
  if (( socket_length > 103 )); then
    printf 'Zellij socket path is too long: %s bytes (maximum 103).\n' "$socket_length" >&2
    printf '  socket_dir=%s (%s bytes)\n' "$socket_dir" "$(LC_ALL=C printf '%s' "${socket_dir%/}" | wc -c | tr -d '[:space:]')" >&2
    printf '  session=%s (%s bytes)\n' "$session" "$(LC_ALL=C printf '%s' "$session" | wc -c | tr -d '[:space:]')" >&2
    printf 'Set GSB_SOCKET_DIR_OVERRIDE to a shorter directory.\n' >&2
    return 1
  fi
}

watchdog_pid_is_alive() {
  local watchdog_pid="$1"
  [[ "$watchdog_pid" =~ ^[0-9]+$ && "$watchdog_pid" -gt 0 ]] && kill -0 "$watchdog_pid" 2>/dev/null
}

watchdog_stale_ms() {
  local value
  value="$(gsb_env_or_default GSB_WATCHDOG_HEARTBEAT_STALE_MS 150000)"
  [[ "$value" =~ ^[0-9]+$ && "$value" -gt 0 ]] || value=150000
  printf '%s\n' "$value"
}

watchdog_heartbeat_age_ms() {
  local watchdog_state_dir="$1"
  local watchdog_pid="$2"
  local heartbeat_pid heartbeat_ts heartbeat_seq now
  [[ -f "$watchdog_state_dir/watchdog.heartbeat" ]] || return 1
  read -r heartbeat_pid heartbeat_ts heartbeat_seq < "$watchdog_state_dir/watchdog.heartbeat" || return 1
  [[ "$heartbeat_pid" == "$watchdog_pid" && "$heartbeat_ts" =~ ^[0-9]+$ && "$heartbeat_seq" =~ ^[0-9]+$ ]] || return 1
  now="$(date +%s)"
  (( heartbeat_ts <= now )) || heartbeat_ts="$now"
  printf '%s\n' "$(( (now - heartbeat_ts) * 1000 ))"
}

watchdog_pid_is_watchdog() {
  local watchdog_pid="$1"
  local command_line=""
  local ps_command
  ps_command="$(gsb_env_or_default GSB_WATCHDOG_PS_COMMAND "")"
  if [[ -n "$ps_command" ]]; then
    command_line="$("$ps_command" "$watchdog_pid" 2>/dev/null || true)"
  else
    command_line="$(ps -p "$watchdog_pid" -o command= 2>/dev/null || true)"
  fi
  [[ "$command_line" == *watchdog.mjs* ]]
}

watchdog_is_healthy() {
  local watchdog_state_dir="$1"
  local watchdog_pid="$2"
  local heartbeat_age
  watchdog_pid_is_alive "$watchdog_pid" || return 1
  watchdog_pid_is_watchdog "$watchdog_pid" || return 1
  heartbeat_age="$(watchdog_heartbeat_age_ms "$watchdog_state_dir" "$watchdog_pid")" || return 1
  (( heartbeat_age < $(watchdog_stale_ms) ))
}

watchdog_can_reap_frozen() {
  local watchdog_state_dir="$1"
  local watchdog_pid="$2"
  local heartbeat_age
  heartbeat_age="$(watchdog_heartbeat_age_ms "$watchdog_state_dir" "$watchdog_pid")" || return 1
  (( heartbeat_age >= $(watchdog_stale_ms) )) && watchdog_pid_is_watchdog "$watchdog_pid"
}

cleanup_watchdog_artifacts() {
  local watchdog_state_dir="$1"
  rm -f \
    "$watchdog_state_dir/watchdog.pid" \
    "$watchdog_state_dir/watchdog.ready" \
    "$watchdog_state_dir/watchdog.heartbeat"
  if [[ -d "$watchdog_state_dir/watchdog.lock" ]]; then
    rmdir "$watchdog_state_dir/watchdog.lock" 2>/dev/null || {
      printf 'Could not remove stale watchdog lock: %s\n' "$watchdog_state_dir/watchdog.lock" >&2
      return 1
    }
  fi
}

launch_watchdog_from_session() {
  local watchdog_state_dir="$1"
  local watchdog_session="$2"
  local watchdog_env_file="$watchdog_state_dir/session.env"
  local watchdog_pid
  local watchdog_ready_file="$watchdog_state_dir/watchdog.ready"
  local watchdog_heartbeat_file="$watchdog_state_dir/watchdog.heartbeat"
  local heartbeat_pid
  local watchdog_roles

  if [[ -f "$watchdog_env_file" ]]; then
    watchdog_pid="$(node -e '
      const { spawn } = require("node:child_process");
      const { openSync } = require("node:fs");
      const log = openSync(process.argv[3], "a");
      const child = spawn("bash", ["-c", "source \"$1\"; exec node \"$2\"", "_", process.argv[1], process.argv[2]], {
        detached: true,
        stdio: ["ignore", log, log],
      });
      child.unref();
      process.stdout.write(String(child.pid));
    ' "$watchdog_env_file" "$ROOT_DIR/bin/watchdog.mjs" "$watchdog_state_dir/watchdog.log")"
  else
    watchdog_roles="$(sed -n 's/^- \([a-z][a-z0-9-]*\):.*/\1/p' "$watchdog_state_dir/ROLES.md" 2>/dev/null | paste -sd, -)"
    watchdog_pid="$(GSB_STATE_DIR="$watchdog_state_dir" \
      GSB_SESSION="$watchdog_session" \
      GSB_LOCAL_ROOT="$ROOT_DIR" \
      GSB_ROLES="${watchdog_roles:-hub}" \
      node -e '
        const { spawn } = require("node:child_process");
        const { openSync } = require("node:fs");
        const log = openSync(process.argv[2], "a");
        const child = spawn(process.execPath, [process.argv[1]], {
          detached: true,
          env: process.env,
          stdio: ["ignore", log, log],
        });
        child.unref();
        process.stdout.write(String(child.pid));
      ' "$ROOT_DIR/bin/watchdog.mjs" "$watchdog_state_dir/watchdog.log")"
  fi
  printf '%s\n' "$watchdog_pid" > "$watchdog_state_dir/watchdog.pid"
  for _ in {1..40}; do
    heartbeat_pid=""
    [[ ! -f "$watchdog_heartbeat_file" ]] || read -r heartbeat_pid _ < "$watchdog_heartbeat_file" || true
    if [[ -f "$watchdog_ready_file" ]] \
      && [[ "$(cat "$watchdog_ready_file" 2>/dev/null || true)" == "$watchdog_pid" ]] \
      && [[ "$heartbeat_pid" == "$watchdog_pid" ]]; then
      return 0
    fi
    if ! watchdog_pid_is_alive "$watchdog_pid"; then
      break
    fi
    sleep 0.05
  done
  printf 'Watchdog failed to become ready for session %s. Inspect %s\n' \
    "$watchdog_session" "$watchdog_state_dir/watchdog.log" >&2
  return 1
}

ensure_open_watchdog() {
  local watchdog_state_dir="$1"
  local watchdog_session="$2"
  local watchdog_enabled="$3"
  ensure_watchdog_state "$watchdog_state_dir" "$watchdog_session" "$watchdog_enabled" true
}

ensure_watchdog_state() {
  local watchdog_state_dir="$1"
  local watchdog_session="$2"
  local watchdog_enabled="$3"
  local session_active="$4"
  local watchdog_pid=""
  WATCHDOG_LAST_HEALTHY=0 WATCHDOG_LAST_REAPED=0 WATCHDOG_LAST_LAUNCHED=0
  [[ "$watchdog_enabled" == true ]] || return 0
  [[ ! -f "$watchdog_state_dir/watchdog.pid" ]] || watchdog_pid="$(cat "$watchdog_state_dir/watchdog.pid" 2>/dev/null || true)"
  if watchdog_is_healthy "$watchdog_state_dir" "$watchdog_pid"; then
    [[ "$session_active" != true ]] || WATCHDOG_LAST_HEALTHY=1
    return 0
  fi
  if watchdog_pid_is_alive "$watchdog_pid"; then
    if ! watchdog_can_reap_frozen "$watchdog_state_dir" "$watchdog_pid"; then
      printf 'Watchdog unhealthy but protected by reaping guard: %s pid=%s\n' "$watchdog_session" "$watchdog_pid" >&2
      return 0
    fi
    if [[ "$(gsb_env_or_default GSB_WATCHDOG_REAP_FROZEN true)" != true ]]; then
      printf 'Frozen watchdog reaping disabled: %s pid=%s\n' "$watchdog_session" "$watchdog_pid" >&2
      return 0
    fi
    kill -9 "$watchdog_pid" 2>/dev/null || true
    for _ in {1..20}; do
      watchdog_pid_is_alive "$watchdog_pid" || break
      sleep 0.05
    done
    if watchdog_pid_is_alive "$watchdog_pid"; then
      printf 'Frozen watchdog did not exit after SIGKILL: %s pid=%s\n' "$watchdog_session" "$watchdog_pid" >&2
      return 1
    fi
    WATCHDOG_LAST_REAPED=1
    printf 'Reaped frozen watchdog: %s pid=%s\n' "$watchdog_session" "$watchdog_pid"
  fi
  cleanup_watchdog_artifacts "$watchdog_state_dir" || return 1
  [[ "$session_active" == true ]] || return 0
  printf 'Restarting missing or stale watchdog for active session: %s\n' "$watchdog_session"
  launch_watchdog_from_session "$watchdog_state_dir" "$watchdog_session" || return 1
  WATCHDOG_LAST_LAUNCHED=1
}

watchdog_session_enabled() {
  local env_file="$1/session.env"
  [[ -f "$env_file" ]] || { printf 'true\n'; return; }
  (
    unset GSB_WATCHDOG_ENABLED
    source "$env_file"
    printf '%s\n' "${GSB_WATCHDOG_ENABLED:-true}"
  )
}

watchdog_session_is_active() {
  local watchdog_state_dir="$1"
  local watchdog_session="$2"
  local socket_dir first_status=1 second_status=1
  socket_dir="$(session_socket_dir_from_env "$watchdog_state_dir/session.env")"
  if [[ -n "$socket_dir" ]]; then
    watchdog_zellij_session_active_in "$socket_dir" "$watchdog_session"
  else
    watchdog_zellij_session_active_in "" "$watchdog_session" && return 0 || first_status=$?
    watchdog_zellij_session_active_in "$(gsb_socket_dir)" "$watchdog_session" && return 0 || second_status=$?
    (( first_status == 1 && second_status == 1 )) && return 1
    return 2
  fi
}

watchdog_ensure_all() {
  local state_root="${XDG_STATE_HOME:-$HOME/.local/state}/gsb-local"
  local state_dir session enabled active active_status failed=false
  local checked=0 healthy=0 reaped=0 launched=0
  [[ -d "$state_root" ]] || { printf 'Watchdog ensure-all: checked=0 healthy=0 reaped=0 launched=0\n'; return; }
  for state_dir in "$state_root"/*; do
    [[ -d "$state_dir" && -f "$state_dir/ROLES.md" ]] || continue
    session="${state_dir##*/}"
    [[ "$session" =~ ^[A-Za-z0-9._-]+$ ]] || continue
    checked=$((checked + 1))
    enabled="$(watchdog_session_enabled "$state_dir")"
    active=false
    active_status=0
    watchdog_session_is_active "$state_dir" "$session" || active_status=$?
    if (( active_status == 2 )); then
      printf 'Watchdog session probe failed; no action: %s\n' "$session" >&2
      continue
    fi
    (( active_status == 0 )) && active=true
    if ! ensure_watchdog_state "$state_dir" "$session" "$enabled" "$active"; then failed=true; fi
    healthy=$((healthy + WATCHDOG_LAST_HEALTHY))
    reaped=$((reaped + WATCHDOG_LAST_REAPED))
    launched=$((launched + WATCHDOG_LAST_LAUNCHED))
  done
  printf 'Watchdog ensure-all: checked=%s healthy=%s reaped=%s launched=%s\n' "$checked" "$healthy" "$reaped" "$launched"
  [[ "$failed" == false ]]
}

watchdog_reaper_plist_path() {
  printf '%s/Library/LaunchAgents/com.gsb.watchdog-reaper.plist\n' "$HOME"
}

watchdog_reaper_plist() {
  local state_root="${XDG_STATE_HOME:-$HOME/.local/state}/gsb-local"
  local stale_ms reap_frozen
  stale_ms="$(watchdog_stale_ms)"
  reap_frozen="$(gsb_env_or_default GSB_WATCHDOG_REAP_FROZEN true)"
  node - "$ROOT_DIR/gsb" "$state_root/watchdog-reaper.log" "${PATH:-/usr/bin:/bin:/usr/sbin:/sbin}" "${XDG_STATE_HOME:-}" "$stale_ms" "$reap_frozen" <<'NODE'
const [program, log, pathValue, stateHome, staleMs, reapFrozen] = process.argv.slice(2);
const escapeXml = (value) => value.replaceAll("&", "&amp;").replaceAll("<", "&lt;");
process.stdout.write(`<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.gsb.watchdog-reaper</string>
  <key>ProgramArguments</key><array><string>${escapeXml(program)}</string><string>watchdog</string><string>ensure-all</string></array>
  <key>StartInterval</key><integer>90</integer>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>${escapeXml(pathValue)}</string>
    <key>GSB_WATCHDOG_HEARTBEAT_STALE_MS</key><string>${escapeXml(staleMs)}</string>
    <key>GSB_WATCHDOG_REAP_FROZEN</key><string>${escapeXml(reapFrozen)}</string>
    ${stateHome ? `<key>XDG_STATE_HOME</key><string>${escapeXml(stateHome)}</string>` : ""}
  </dict>
  <key>StandardOutPath</key><string>${escapeXml(log)}</string>
  <key>StandardErrorPath</key><string>${escapeXml(log)}</string>
</dict></plist>
`);
NODE
}

watchdog_reaper_install() {
  local plist
  plist="$(watchdog_reaper_plist_path)"
  mkdir -p "$(dirname "$plist")" "${XDG_STATE_HOME:-$HOME/.local/state}/gsb-local"
  watchdog_reaper_plist > "$plist.tmp.$$"
  chmod 600 "$plist.tmp.$$"
  mv "$plist.tmp.$$" "$plist"
  launchctl bootout "gui/$(id -u)/com.gsb.watchdog-reaper" >/dev/null 2>&1 || true
  launchctl bootstrap "gui/$(id -u)" "$plist"
  printf 'Watchdog reaper installed: %s (next trigger within 90s)\n' "$plist"
}

watchdog_reaper_uninstall() {
  local plist
  plist="$(watchdog_reaper_plist_path)"
  launchctl bootout "gui/$(id -u)/com.gsb.watchdog-reaper" >/dev/null 2>&1 || true
  rm -f "$plist"
  printf 'Watchdog reaper uninstalled: %s\n' "$plist"
}

watchdog_reaper_status() {
  local plist
  plist="$(watchdog_reaper_plist_path)"
  if launchctl print "gui/$(id -u)/com.gsb.watchdog-reaper" >/dev/null 2>&1; then
    printf 'Watchdog reaper: installed and loaded; next trigger within 90s\n'
  elif [[ -f "$plist" ]]; then
    printf 'Watchdog reaper: installed but not loaded; no trigger scheduled\n'
  else
    printf 'Watchdog reaper: not installed; no trigger scheduled\n'
  fi
}

# A Zellij server permanently inherits the environment of its creator. If GSB is
# launched from inside another Claude tool process, these markers can make new
# Claude panes look like nested sessions and suppress transcript persistence.
PARENT_ENV_SANITIZED=false
for tainted_var in \
  CLAUDECODE \
  CLAUDE_CODE_SESSION_ID \
  CLAUDE_CODE_CHILD_SESSION \
  CLAUDE_CODE_BRIDGE_SESSION_ID \
  CLAUDE_JOB_DIR \
  CLAUDE_CODE_ENTRYPOINT \
  CLAUDE_CODE_EXECPATH \
  CLAUDE_PID; do
  if [[ -n "${!tainted_var:-}" ]]; then
    PARENT_ENV_SANITIZED=true
    unset "$tainted_var"
  fi
done
if [[ -z "${TERM:-}" || "${TERM:-}" == "dumb" ]]; then
  export TERM=xterm-256color
fi

if [[ "${1:-}" == "watchdog" ]]; then
  WATCHDOG_COMMAND="${2:-status}"
  [[ -z "${3:-}" ]] || { printf 'Usage: gsb-local watchdog ensure-all|install|uninstall|status\n' >&2; exit 1; }
  case "$WATCHDOG_COMMAND" in
    ensure-all) watchdog_ensure_all ;;
    install) watchdog_reaper_install ;;
    uninstall) watchdog_reaper_uninstall ;;
    status) watchdog_reaper_status ;;
    *) printf 'Usage: gsb-local watchdog ensure-all|install|uninstall|status\n' >&2; exit 1 ;;
  esac
  exit 0
fi

if [[ "${1:-}" == "layout-status" ]]; then
  shift
  LAYOUT_STATUS_SESSION="${1:-${GSB_SESSION:-${ZELLIJ_SESSION_NAME:-seed-gsb}}}"
  if [[ -n "${1:-}" ]]; then
    LAYOUT_STATUS_STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/gsb-local/$LAYOUT_STATUS_SESSION"
  else
    LAYOUT_STATUS_STATE_DIR="${GSB_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/gsb-local/$LAYOUT_STATUS_SESSION}"
  fi
  [[ ! -f "$LAYOUT_STATUS_STATE_DIR/session.env" ]] || source "$LAYOUT_STATUS_STATE_DIR/session.env"
  export GSB_SESSION="$LAYOUT_STATUS_SESSION" GSB_STATE_DIR="$LAYOUT_STATUS_STATE_DIR"
  exec node "$ROOT_DIR/bin/layout-status.mjs" "$@"
fi

if [[ "${1:-}" == "studio" ]]; then
  shift
  exec node "$ROOT_DIR/studio/server.mjs" "$@"
fi

if [[ "${1:-}" == "open" || "${1:-}" == "attach" ]]; then
  shift
  OPEN_BACKGROUND=false
  if [[ "${1:-}" == "--background" ]]; then
    OPEN_BACKGROUND=true
    shift
  fi
  OPEN_SESSION="${1:-}"
  if [[ -z "$OPEN_SESSION" ]]; then
    printf 'Usage: gsb-local open [--background] SESSION\n' >&2
    exit 1
  fi
  if [[ -n "${2:-}" ]]; then
    printf 'Unexpected argument after session name: %s\n' "$2" >&2
    exit 1
  fi
  if [[ ! "$OPEN_SESSION" =~ ^[A-Za-z0-9._-]+$ ]]; then
    printf 'Session name may only contain letters, numbers, dot, underscore, and hyphen.\n' >&2
    exit 1
  fi
  for required_command in zellij node; do
    if ! command -v "$required_command" >/dev/null 2>&1; then
      printf 'Missing required command: %s\n' "$required_command" >&2
      exit 1
    fi
  done

  OPEN_STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/gsb-local/$OPEN_SESSION"
  OPEN_METADATA="$OPEN_STATE_DIR/session.json"
  OPEN_WORKSPACE=""
  OPEN_FULL_ACCESS=false
  OPEN_WATCHDOG=true
  OPEN_CONFIG_SOURCE=""
  OPEN_CONFIG_PATH=""
  OPEN_CONFIG_PROFILE=""
  OPEN_MODELS_CONFIG_PATH=""
  if [[ -f "$OPEN_METADATA" ]]; then
    OPEN_SAVED_SESSION="$(node "$ROOT_DIR/bin/session-meta.mjs" get "$OPEN_METADATA" session)"
    if [[ "$OPEN_SAVED_SESSION" != "$OPEN_SESSION" ]]; then
      printf 'Session metadata mismatch: requested %s but metadata contains %s\n' "$OPEN_SESSION" "$OPEN_SAVED_SESSION" >&2
      exit 1
    fi
    OPEN_WORKSPACE="$(node "$ROOT_DIR/bin/session-meta.mjs" get "$OPEN_METADATA" workspace)"
    OPEN_FULL_ACCESS="$(node "$ROOT_DIR/bin/session-meta.mjs" get "$OPEN_METADATA" fullAccess 2>/dev/null || printf false)"
    OPEN_WATCHDOG="$(node "$ROOT_DIR/bin/session-meta.mjs" get "$OPEN_METADATA" watchdogEnabled 2>/dev/null || printf true)"
    OPEN_CONFIG_SOURCE="$(node "$ROOT_DIR/bin/session-meta.mjs" get "$OPEN_METADATA" configSource 2>/dev/null || true)"
    OPEN_CONFIG_PATH="$(node "$ROOT_DIR/bin/session-meta.mjs" get "$OPEN_METADATA" configPath 2>/dev/null || true)"
    OPEN_CONFIG_PROFILE="$(node "$ROOT_DIR/bin/session-meta.mjs" get "$OPEN_METADATA" configProfile 2>/dev/null || true)"
    OPEN_MODELS_CONFIG_PATH="$(node "$ROOT_DIR/bin/session-meta.mjs" get "$OPEN_METADATA" modelsConfigPath 2>/dev/null || true)"
  elif [[ -f "$OPEN_STATE_DIR/TASK.md" ]]; then
    # One-time compatibility for sessions created before session.json existed.
    OPEN_WORKSPACE="$(sed -n 's/^Workspace: //p' "$OPEN_STATE_DIR/TASK.md" | head -n 1)"
    if [[ -f "$OPEN_STATE_DIR/session.env" ]] && grep -q '^export GSB_FULL_ACCESS=true$' "$OPEN_STATE_DIR/session.env"; then
      OPEN_FULL_ACCESS=true
    fi
  fi
  if [[ -z "$OPEN_WORKSPACE" ]]; then
    printf 'No durable GSB metadata found for session: %s\n' "$OPEN_SESSION" >&2
    printf 'Start it once with: gsb-local /absolute/project/path %s\n' "$OPEN_SESSION" >&2
    exit 1
  fi
  if [[ ! -d "$OPEN_WORKSPACE" ]]; then
    printf 'Saved workspace no longer exists for %s: %s\n' "$OPEN_SESSION" "$OPEN_WORKSPACE" >&2
    exit 1
  fi

  OPEN_PRIMARY_SOCKET_DIR="$(session_socket_dir_from_env "$OPEN_STATE_DIR/session.env")"
  [[ -n "$OPEN_PRIMARY_SOCKET_DIR" ]] || OPEN_PRIMARY_SOCKET_DIR="$(gsb_socket_dir)"
  OPEN_LEGACY_SOCKET_DIR="$(default_zellij_socket_dir)"
  OPEN_PRIMARY_ACTIVE=false
  OPEN_LEGACY_ACTIVE=false
  zellij_session_active_in "$OPEN_PRIMARY_SOCKET_DIR" "$OPEN_SESSION" && OPEN_PRIMARY_ACTIVE=true
  if [[ "$OPEN_PRIMARY_SOCKET_DIR" != "$OPEN_LEGACY_SOCKET_DIR" ]]; then
    zellij_session_active_in "" "$OPEN_SESSION" && OPEN_LEGACY_ACTIVE=true
  fi
  if [[ "$OPEN_PRIMARY_ACTIVE" == true && "$OPEN_LEGACY_ACTIVE" == true ]]; then
    printf 'Ambiguous Zellij session %s is active in both socket directories:\n  %s\n  %s\n' \
      "$OPEN_SESSION" "$OPEN_PRIMARY_SOCKET_DIR" "$OPEN_LEGACY_SOCKET_DIR" >&2
    exit 1
  fi
  if [[ "$OPEN_PRIMARY_ACTIVE" == true || "$OPEN_LEGACY_ACTIVE" == true ]]; then
    if [[ "$OPEN_PRIMARY_ACTIVE" == true ]]; then
      use_zellij_socket_dir "$OPEN_PRIMARY_SOCKET_DIR"
    else
      use_zellij_socket_dir ""
    fi
    unset ZELLIJ_SESSION_NAME ZELLIJ_SESSION_DIR
    ensure_open_watchdog "$OPEN_STATE_DIR" "$OPEN_SESSION" "$OPEN_WATCHDOG"
    if [[ "$OPEN_BACKGROUND" == true ]]; then
      printf 'Zellij session is already active in the background: %s\n' "$OPEN_SESSION"
      exit 0
    fi
    printf 'Attaching to %s (workspace: %s)\n' "$OPEN_SESSION" "$OPEN_WORKSPACE"
    exec zellij attach "$OPEN_SESSION"
  fi

  # Do not let a shell inside some other GSB session leak its runtime contract
  # into the session being reopened. Reconstruct only from durable metadata.
  for inherited_var in $(compgen -v GSB_); do
    unset "$inherited_var"
  done
  unset ZELLIJ_SESSION_NAME ZELLIJ_SESSION_DIR

  OPEN_ARGS=()
  [[ "$OPEN_BACKGROUND" == true ]] && OPEN_ARGS+=(--background)
  [[ "$OPEN_FULL_ACCESS" == true ]] && OPEN_ARGS+=(--full-access)
  if [[ "$OPEN_CONFIG_SOURCE" == profile && -n "$OPEN_CONFIG_PROFILE" ]]; then
    OPEN_ARGS+=(--config "$OPEN_CONFIG_PROFILE")
  elif [[ -n "$OPEN_CONFIG_PATH" && "$OPEN_CONFIG_SOURCE" == project && "$OPEN_CONFIG_PATH" != "$OPEN_WORKSPACE/.gsb-local/agents.conf" ]]; then
    export GSB_CONFIG="$OPEN_CONFIG_PATH"
  fi
  if [[ -n "$OPEN_MODELS_CONFIG_PATH" && "$OPEN_MODELS_CONFIG_PATH" != "$OPEN_WORKSPACE/.gsb-local/models.conf" ]]; then
    export GSB_MODELS_CONFIG="$OPEN_MODELS_CONFIG_PATH"
  fi
  export GSB_SOCKET_DIR_OVERRIDE="$OPEN_PRIMARY_SOCKET_DIR"
  export GSB_WATCHDOG_ENABLED="$OPEN_WATCHDOG"
  printf 'Reopening %s from durable workspace: %s\n' "$OPEN_SESSION" "$OPEN_WORKSPACE"
  exec "$ROOT_DIR/gsb" "${OPEN_ARGS[@]}" "$OPEN_WORKSPACE" "$OPEN_SESSION"
fi

if [[ "${1:-}" == "--check" ]]; then
  printf 'GSB Local: %s\n' "$ROOT_DIR"
  printf 'Zellij:   %s\n' "$(zellij --version 2>/dev/null || printf 'missing')"
  printf 'Claude:   %s\n' "$(claude --version 2>/dev/null || printf 'missing')"
  printf 'Codex:    %s\n' "$(codex --version 2>/dev/null || printf 'missing')"
  printf 'Kimi:     %s\n' "$(kimi --version 2>/dev/null || printf 'missing')"
  exit 0
fi

REBUILD=false
PRINT_CONFIG=false
BACKGROUND=false
FULL_ACCESS=false
CONFIG_PROFILE=""
LIST_CONFIGS=false
while [[ "${1:-}" == --* ]]; do
  case "$1" in
    --rebuild) REBUILD=true ;;
    --print-config) PRINT_CONFIG=true ;;
    --background) BACKGROUND=true ;;
    --full-access) FULL_ACCESS=true ;;
    --list-configs) LIST_CONFIGS=true ;;
    --config[0-9]*) CONFIG_PROFILE="${1#--}" ;;
    --config)
      if [[ -z "${2:-}" || "${2:-}" == --* ]]; then
        printf 'Missing profile name after --config.\n' >&2
        exit 1
      fi
      CONFIG_PROFILE="$2"
      shift
      ;;
    --help)
      printf '%s\n' \
        'Usage: gsb-local [--rebuild] [--background] [--full-access] [--config PROFILE|--configN] [WORKSPACE] [SESSION]' \
        '       gsb-local open [--background] SESSION' \
        '       gsb-local layout-status [SESSION]' \
        '       gsb-local watchdog ensure-all|install|uninstall|status' \
        '       gsb-local studio [--project PATH] [--port PORT] [--no-open]' \
        '       gsb-local --print-config [WORKSPACE] [SESSION]' \
        '       gsb-local --list-configs' \
        '       gsb-local --check'
      exit 0
      ;;
    *)
      printf 'Unknown option: %s\n' "$1" >&2
      exit 1
      ;;
  esac
  shift
done

if [[ "$LIST_CONFIGS" == true ]]; then
  for profile_path in "$ROOT_DIR"/profiles/*.conf; do
    [[ -f "$profile_path" ]] || continue
    profile_name="${profile_path##*/}"
    profile_name="${profile_name%.conf}"
    printf '%s:\n' "$profile_name"
    while IFS= read -r profile_line || [[ -n "$profile_line" ]]; do
      profile_line="$(printf '%s' "$profile_line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
      [[ -z "$profile_line" || "${profile_line:0:1}" == "#" ]] && continue
      printf '  %s\n' "$profile_line"
    done < "$profile_path"
  done
  exit 0
fi

# A pane context carries the current session's runtime contract. Strip only
# those runtime values so documented and role-scoped inputs remain available.
PANE_RUNTIME_VARS=(
  GSB_LOCAL_ROOT GSB_WORKSPACE GSB_SESSION GSB_AGENT GSB_STATE_DIR
  GSB_PROJECT_DIR GSB_PROMPTS_DIR GSB_PROFILES_DIR
  GSB_CONFIG_PATH GSB_MODELS_CONFIG_PATH GSB_CONFIG_SOURCE GSB_CONFIG_PROFILE
  GSB_PROTOCOL_FILE GSB_ROLE_ROSTER GSB_LAYOUT_FILE GSB_SESSION_ENV_FILE
  GSB_SESSION_METADATA_FILE GSB_ROLES GSB_WATCHDOG_ENABLED
  GSB_FULL_ACCESS GSB_PERMISSION_PROFILE GSB_PERMISSION_MODE
  GSB_CODEX_APPROVAL GSB_CODEX_SANDBOX GSB_KIMI_PERMISSION
)
if [[ -n "${ZELLIJ_SESSION_NAME:-}${ZELLIJ_SESSION_DIR:-}" ]]; then
  if [[ -n "${GSB_PERMISSION_MODE:-}" ]]; then
    printf 'warning: inherited GSB_PERMISSION_MODE was stripped in pane context; use a clean shell to override permissions.\n' >&2
  fi
  for inherited_var in "${PANE_RUNTIME_VARS[@]}"; do
    unset "$inherited_var"
  done
fi
unset ZELLIJ_SESSION_NAME ZELLIJ_SESSION_DIR

WORKSPACE="${1:-$PWD}"
SESSION="${2:-seed-gsb}"

if [[ -n "$CONFIG_PROFILE" && ! "$CONFIG_PROFILE" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
  printf 'Config profile names may only contain letters, numbers, dot, underscore, and hyphen.\n' >&2
  exit 1
fi

if [[ "$FULL_ACCESS" == true ]]; then
  export GSB_FULL_ACCESS=true
  export GSB_PERMISSION_PROFILE=full-access
  export GSB_PERMISSION_MODE=bypassPermissions
  export GSB_CODEX_APPROVAL=never
  export GSB_CODEX_SANDBOX=danger-full-access
  export GSB_KIMI_PERMISSION=auto
else
  export GSB_FULL_ACCESS=false
  export GSB_PERMISSION_PROFILE=balanced
  export GSB_PERMISSION_MODE="${GSB_PERMISSION_MODE:-acceptEdits}"
  export GSB_CODEX_APPROVAL="${GSB_CODEX_APPROVAL:-on-request}"
  export GSB_CODEX_SANDBOX="${GSB_CODEX_SANDBOX:-workspace-write}"
  export GSB_KIMI_PERMISSION="${GSB_KIMI_PERMISSION:-yolo}"
fi
export GSB_WATCHDOG_ENABLED="${GSB_WATCHDOG_ENABLED:-true}"

if [[ ! -d "$WORKSPACE" ]]; then
  printf 'Workspace does not exist: %s\n' "$WORKSPACE" >&2
  exit 1
fi
WORKSPACE="$(cd "$WORKSPACE" && pwd)"

if [[ ! "$SESSION" =~ ^[A-Za-z0-9._-]+$ ]]; then
  printf 'Session name may only contain letters, numbers, dot, underscore, and hyphen.\n' >&2
  exit 1
fi

PROJECT_DIR="$WORKSPACE/.gsb-local"
[[ ! -d "$PROJECT_DIR/projects/$SESSION" ]] || PROJECT_DIR="$PROJECT_DIR/projects/$SESSION"
PROMPTS_DIR="$PROJECT_DIR/prompts"
PROFILES_DIR="$PROJECT_DIR/profiles"
[[ -d "$PROFILES_DIR" || "$PROJECT_DIR" == "$WORKSPACE/.gsb-local" ]] || PROFILES_DIR="$WORKSPACE/.gsb-local/profiles"

ROLE_PATTERN='^[a-z][a-z0-9-]*$'
ROLES=()
AGENT_SPECS=()
MODEL_ROLES=()
MODEL_SPECS=()

canonical_role() {
  printf '%s' "${1//_/-}"
}

role_env_var() {
  local normalized
  normalized="$(printf '%s' "$1" | tr '[:lower:]-' '[:upper:]_')"
  printf 'GSB_%s_AGENT' "$normalized"
}

role_model_env_var() {
  local normalized
  normalized="$(printf '%s' "$1" | tr '[:lower:]-' '[:upper:]_')"
  printf 'GSB_%s_MODEL' "$normalized"
}

role_exists() {
  local wanted="$1"
  local role
  for role in ${ROLES[@]+"${ROLES[@]}"}; do
    [[ "$role" == "$wanted" ]] && return 0
  done
  return 1
}

add_role() {
  local role
  local spec="$2"
  role="$(canonical_role "$1")"
  if [[ ! "$role" =~ $ROLE_PATTERN ]]; then
    printf 'Invalid role in %s: %s\n' "$CONFIG_PATH" "$1" >&2
    printf 'Role names must use lowercase letters, numbers, and hyphens.\n' >&2
    exit 1
  fi
  if role_exists "$role"; then
    printf 'Duplicate role in %s: %s\n' "$CONFIG_PATH" "$role" >&2
    exit 1
  fi
  ROLES[${#ROLES[@]}]="$role"
  AGENT_SPECS[${#AGENT_SPECS[@]}]="$spec"
}

add_role_model() {
  local role
  role="$(canonical_role "$1")"
  if ! role_exists "$role"; then
    printf 'Model configured for inactive role in %s: %s\n' "$MODELS_CONFIG_PATH" "$role" >&2
    exit 1
  fi
  for configured_role in ${MODEL_ROLES[@]+"${MODEL_ROLES[@]}"}; do
    if [[ "$configured_role" == "$role" ]]; then
      printf 'Duplicate model role in %s: %s\n' "$MODELS_CONFIG_PATH" "$role" >&2
      exit 1
    fi
  done
  MODEL_ROLES[${#MODEL_ROLES[@]}]="$role"
  MODEL_SPECS[${#MODEL_SPECS[@]}]="$2"
}

model_for_role() {
  local wanted="$1"
  local model_index
  for ((model_index = 0; model_index < ${#MODEL_ROLES[@]}; model_index++)); do
    if [[ "${MODEL_ROLES[$model_index]}" == "$wanted" ]]; then
      printf '%s' "${MODEL_SPECS[$model_index]}"
      return 0
    fi
  done
  return 1
}

prompt_for_role() {
  local role="$1"
  local project_prompt="$PROMPTS_DIR/$role.md"
  local builtin_prompt="$ROOT_DIR/prompts/$role.md"
  # Hub orchestration is a GSB invariant. Project/template configuration may
  # add capabilities through hub-extension.md, but it cannot replace the core.
  if [[ "$role" == hub ]]; then
    [[ -f "$builtin_prompt" ]] || return 1
    printf '%s' "$builtin_prompt"
    return 0
  fi
  if [[ -f "$project_prompt" ]]; then
    printf '%s' "$project_prompt"
  elif [[ -f "$builtin_prompt" ]]; then
    printf '%s' "$builtin_prompt"
  else
    return 1
  fi
}

if [[ -n "$CONFIG_PROFILE" ]]; then
  PROJECT_PROFILE_PATH="$PROFILES_DIR/$CONFIG_PROFILE.conf"
  BUILTIN_PROFILE_PATH="$ROOT_DIR/profiles/$CONFIG_PROFILE.conf"
  CONFIG_SOURCE=profile
  if [[ -f "$PROJECT_PROFILE_PATH" ]]; then
    CONFIG_PATH="$PROJECT_PROFILE_PATH"
  elif [[ -f "$BUILTIN_PROFILE_PATH" ]]; then
    CONFIG_PATH="$BUILTIN_PROFILE_PATH"
  else
    printf 'Unknown GSB config profile: %s\n' "$CONFIG_PROFILE" >&2
    printf 'Looked for:\n  %s\n  %s\n' "$PROJECT_PROFILE_PATH" "$BUILTIN_PROFILE_PATH" >&2
    exit 1
  fi
else
  REQUESTED_CONFIG_PATH="${GSB_CONFIG:-$PROJECT_DIR/agents.conf}"
  CONFIG_SOURCE=project
  if [[ -f "$REQUESTED_CONFIG_PATH" ]]; then
    CONFIG_PATH="$REQUESTED_CONFIG_PATH"
  elif [[ -n "${GSB_CONFIG:-}" ]]; then
    printf 'GSB_CONFIG does not exist: %s\n' "$REQUESTED_CONFIG_PATH" >&2
    exit 1
  else
    CONFIG_PATH="$ROOT_DIR/defaults/agents.conf"
    CONFIG_SOURCE=default
  fi
fi

if [[ ! -f "$CONFIG_PATH" ]]; then
  printf 'Missing default GSB config: %s\n' "$CONFIG_PATH" >&2
  exit 1
fi

while IFS= read -r config_line || [[ -n "$config_line" ]]; do
  trimmed_line="$(printf '%s' "$config_line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
  [[ -z "$trimmed_line" || "${trimmed_line:0:1}" == "#" ]] && continue
  if [[ "$trimmed_line" != *=* ]]; then
    printf 'Invalid config line in %s: %s\n' "$CONFIG_PATH" "$config_line" >&2
    exit 1
  fi
  config_key="$(printf '%s' "${trimmed_line%%=*}" | sed -e 's/[[:space:]]*$//')"
  config_value="$(printf '%s' "${trimmed_line#*=}" | sed -e 's/^[[:space:]]*//')"
  if [[ -z "$config_value" ]]; then
    printf 'Empty agent command for %s in %s\n' "$config_key" "$CONFIG_PATH" >&2
    exit 1
  fi
  if [[ "$CONFIG_SOURCE" == default && -n "${GSB_AGENT:-}" ]]; then
    config_value="$GSB_AGENT"
  fi
  add_role "$config_key" "$config_value"
done < "$CONFIG_PATH"

if ! role_exists hub; then
  printf 'Missing required hub role in %s.\n' "$CONFIG_PATH" >&2
  exit 1
fi

REQUESTED_MODELS_PATH="${GSB_MODELS_CONFIG:-$PROJECT_DIR/models.conf}"
MODELS_CONFIG_PATH=""
if [[ -f "$REQUESTED_MODELS_PATH" ]]; then
  MODELS_CONFIG_PATH="$REQUESTED_MODELS_PATH"
elif [[ -n "${GSB_MODELS_CONFIG:-}" ]]; then
  printf 'GSB_MODELS_CONFIG does not exist: %s\n' "$REQUESTED_MODELS_PATH" >&2
  exit 1
fi

if [[ -n "$MODELS_CONFIG_PATH" ]]; then
  while IFS= read -r model_line || [[ -n "$model_line" ]]; do
    trimmed_model_line="$(printf '%s' "$model_line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
    [[ -z "$trimmed_model_line" || "${trimmed_model_line:0:1}" == "#" ]] && continue
    if [[ "$trimmed_model_line" != *=* ]]; then
      printf 'Invalid model config line in %s: %s\n' "$MODELS_CONFIG_PATH" "$model_line" >&2
      exit 1
    fi
    model_key="$(printf '%s' "${trimmed_model_line%%=*}" | sed -e 's/[[:space:]]*$//')"
    model_value="$(printf '%s' "${trimmed_model_line#*=}" | sed -e 's/^[[:space:]]*//')"
    if [[ -z "$model_value" ]]; then
      printf 'Empty model for %s in %s\n' "$model_key" "$MODELS_CONFIG_PATH" >&2
      exit 1
    fi
    add_role_model "$model_key" "$model_value"
  done < "$MODELS_CONFIG_PATH"
fi

for ((role_index = 0; role_index < ${#ROLES[@]}; role_index++)); do
  role="${ROLES[$role_index]}"
  role_var="$(role_env_var "$role")"
  if [[ -n "${!role_var:-}" ]]; then
    AGENT_SPECS[$role_index]="${!role_var}"
  fi
  printf -v "$role_var" '%s' "${AGENT_SPECS[$role_index]}"
  export "$role_var"
  role_model_var="$(role_model_env_var "$role")"
  if [[ -z "${!role_model_var:-}" ]] && configured_model="$(model_for_role "$role")"; then
    printf -v "$role_model_var" '%s' "$configured_model"
  fi
  if [[ -n "${!role_model_var:-}" ]]; then
    export "$role_model_var"
  fi
  if ! prompt_for_role "$role" >/dev/null; then
    printf 'Missing prompt for active role %s. Add one at either:\n' "$role" >&2
    printf '  %s\n  %s\n' "$PROMPTS_DIR/$role.md" "$ROOT_DIR/prompts/$role.md" >&2
    exit 1
  fi
done

previous_ifs="$IFS"
IFS=,
GSB_ROLES="${ROLES[*]}"
IFS="$previous_ifs"
export GSB_ROLES

if [[ "$PRINT_CONFIG" == true ]]; then
  config_suffix=""
  if [[ "$CONFIG_SOURCE" == default ]]; then
    config_suffix=" (default)"
  fi
  printf 'Workspace: %s\n' "$WORKSPACE"
  printf 'Config:    %s%s\n' "$CONFIG_PATH" "$config_suffix"
  if [[ -n "$CONFIG_PROFILE" ]]; then
    printf 'Profile:   %s\n' "$CONFIG_PROFILE"
  fi
  printf 'Roles:     %s\n' "$GSB_ROLES"
  printf 'Permissions: %s\n' "$GSB_PERMISSION_PROFILE"
  for ((role_index = 0; role_index < ${#ROLES[@]}; role_index++)); do
    role_model_var="$(role_model_env_var "${ROLES[$role_index]}")"
    printf '%-16s %-20s model=%-24s prompt=%s\n' \
      "${ROLES[$role_index]}:" \
      "${AGENT_SPECS[$role_index]}" \
      "${!role_model_var:-<agent-default>}" \
      "$(prompt_for_role "${ROLES[$role_index]}")"
  done
  exit 0
fi

for required_command in zellij node; do
  if ! command -v "$required_command" >/dev/null 2>&1; then
    printf 'Missing required command: %s\n' "$required_command" >&2
    exit 1
  fi
done

command_or_alias_exists() {
  local command_name="$1"
  if command -v "$command_name" >/dev/null 2>&1; then
    return 0
  fi
  [[ "$command_name" =~ ^[A-Za-z_][A-Za-z0-9._-]*$ ]] || return 1
  /bin/zsh -ic 'whence -w -- "$1" >/dev/null 2>&1' gsb-check "$command_name" >/dev/null 2>&1
}

for ((role_index = 0; role_index < ${#ROLES[@]}; role_index++)); do
  role="${ROLES[$role_index]}"
  agent_spec="${AGENT_SPECS[$role_index]}"
  case "$agent_spec" in
    claude) agent_binary="claude" ;;
    codex) agent_binary="codex" ;;
    kimi) agent_binary="kimi" ;;
    claude:*|codex:*|kimi:*) agent_binary="${agent_spec#*:}" ;;
    shell:*)
      if [[ -z "${agent_spec#shell:}" ]]; then
        printf 'Empty shell command configured for role: %s\n' "$role" >&2
        exit 1
      fi
      continue
      ;;
    *)
      if [[ "$agent_spec" =~ ^[A-Za-z_][A-Za-z0-9._-]*$ ]]; then
        # Bare custom commands remain Claude-compatible for backwards compatibility.
        agent_binary="$agent_spec"
      else
        printf 'Unsupported agent spec for %s: %s\n' "$role" "$agent_spec" >&2
        printf 'Use claude, codex, kimi, a compatible adapter, or shell:<command>.\n' >&2
        exit 1
      fi
      ;;
  esac
  if [[ -z "$agent_binary" ]] || ! command_or_alias_exists "$agent_binary"; then
    printf 'Missing command for %s: %s\n' "$role" "${agent_binary:-<empty>}" >&2
    exit 1
  fi
done

export GSB_LOCAL_ROOT="$ROOT_DIR"
export GSB_WORKSPACE="$WORKSPACE"
export GSB_SESSION="$SESSION"
export GSB_AGENT="${GSB_AGENT:-claude}"
export GSB_STATE_DIR="${GSB_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/gsb-local/$SESSION}"
SAVED_SOCKET_DIR=""
if [[ -z "${GSB_SOCKET_DIR_OVERRIDE:-}" ]]; then
  SAVED_SOCKET_DIR="$(session_socket_dir_from_env "$GSB_STATE_DIR/session.env" 2>/dev/null || true)"
fi
export ZELLIJ_SOCKET_DIR="${SAVED_SOCKET_DIR:-$(gsb_socket_dir)}"
export GSB_PROJECT_DIR="$PROJECT_DIR"
export GSB_PROMPTS_DIR="$PROMPTS_DIR"
export GSB_PROFILES_DIR="$PROFILES_DIR"
export GSB_CONFIG_PATH="$CONFIG_PATH"
export GSB_MODELS_CONFIG_PATH="$MODELS_CONFIG_PATH"
export GSB_CONFIG_SOURCE="$CONFIG_SOURCE"
export GSB_CONFIG_PROFILE="$CONFIG_PROFILE"
export GSB_PROTOCOL_FILE="$ROOT_DIR/protocol/dispatch.md"
export GSB_ROLE_ROSTER="$GSB_STATE_DIR/ROLES.md"
export GSB_LAYOUT_FILE="$GSB_STATE_DIR/layouts/current.kdl"
export GSB_SESSION_ENV_FILE="$GSB_STATE_DIR/session.env"
export GSB_SESSION_METADATA_FILE="$GSB_STATE_DIR/session.json"

existing_workspace=""
if [[ -f "$GSB_SESSION_METADATA_FILE" ]]; then
  if ! existing_workspace="$(node "$ROOT_DIR/bin/session-meta.mjs" get "$GSB_SESSION_METADATA_FILE" workspace)"; then
    printf 'Refusing to overwrite invalid session metadata: %s\n' "$GSB_SESSION_METADATA_FILE" >&2
    exit 1
  fi
  existing_session="$(node "$ROOT_DIR/bin/session-meta.mjs" get "$GSB_SESSION_METADATA_FILE" session)"
  if [[ "$existing_session" != "$SESSION" ]]; then
    printf 'Session metadata mismatch: requested %s but metadata contains %s\n' "$SESSION" "$existing_session" >&2
    exit 1
  fi
elif [[ -f "$GSB_STATE_DIR/TASK.md" ]]; then
  existing_workspace="$(sed -n 's/^Workspace: //p' "$GSB_STATE_DIR/TASK.md" | head -n 1)"
fi
if [[ -n "$existing_workspace" && "$existing_workspace" != "$WORKSPACE" ]]; then
  printf 'Session %s belongs to a different workspace.\n' "$SESSION" >&2
  printf '  Saved:     %s\n' "$existing_workspace" >&2
  printf '  Requested: %s\n' "$WORKSPACE" >&2
  printf 'Choose another session name, or reopen the saved session with: gsb-local open %s\n' "$SESSION" >&2
  exit 1
fi

# Attaching to an already-running session must be read-only. In particular,
# do not rewrite its environment, roster, layout, or metadata from whichever
# directory/config happened to invoke gsb-local a second time.
PRIMARY_SOCKET_DIR="$ZELLIJ_SOCKET_DIR"
LEGACY_SOCKET_DIR="$(default_zellij_socket_dir)"
PRIMARY_ACTIVE=false
LEGACY_ACTIVE=false
zellij_session_active_in "$PRIMARY_SOCKET_DIR" "$SESSION" && PRIMARY_ACTIVE=true
if [[ "$PRIMARY_SOCKET_DIR" != "$LEGACY_SOCKET_DIR" ]]; then
  zellij_session_active_in "" "$SESSION" && LEGACY_ACTIVE=true
fi
if [[ "$PRIMARY_ACTIVE" == true && "$LEGACY_ACTIVE" == true ]]; then
  printf 'Ambiguous Zellij session %s is active in both socket directories:\n  %s\n  %s\n' \
    "$SESSION" "$PRIMARY_SOCKET_DIR" "$LEGACY_SOCKET_DIR" >&2
  exit 1
fi
if [[ "$REBUILD" == true && "$LEGACY_ACTIVE" == true ]]; then
  printf 'Refusing to rebuild legacy session %s in the default socket directory; attach it or close it first.\n' "$SESSION" >&2
  exit 1
fi
if [[ "$REBUILD" != true && ( "$PRIMARY_ACTIVE" == true || "$LEGACY_ACTIVE" == true ) ]]; then
  if [[ "$PRIMARY_ACTIVE" == true ]]; then
    use_zellij_socket_dir "$PRIMARY_SOCKET_DIR"
  else
    use_zellij_socket_dir ""
  fi
  if [[ "$BACKGROUND" == true ]]; then
    printf 'Zellij session is already active in the background: %s\n' "$SESSION"
    exit 0
  fi
  printf 'Attaching to active Zellij session: %s\n' "$SESSION"
  exec zellij attach "$SESSION"
fi

use_zellij_socket_dir "$PRIMARY_SOCKET_DIR"
SESSION_LIST="$(zellij list-sessions --no-formatting 2>/dev/null || true)"
validate_socket_path_length "$PRIMARY_SOCKET_DIR" "$SESSION"

mkdir -p "$GSB_STATE_DIR/reports" "$GSB_STATE_DIR/contracts" "$GSB_STATE_DIR/layouts" "$GSB_STATE_DIR/agent-files"
for role in "${ROLES[@]}"; do
  mkdir -p "$GSB_STATE_DIR/inbox/$role" "$GSB_STATE_DIR/inbox-archive/$role"
done

# A persistent Zellij server keeps the environment of the process that first
# created it. Never rely on that server-global environment for a GSB pane:
# write the complete session-scoped runtime contract and source it from every
# generated pane before supervise/run-agent starts.
session_env_tmp="$GSB_SESSION_ENV_FILE.$$.tmp"
write_session_export() {
  local variable_name="$1"
  local variable_value="${!variable_name:-}"
  printf 'export %s=%q\n' "$variable_name" "$variable_value"
}
{
  printf '%s\n' '# Generated by gsb-local. Session-scoped; do not share across workspaces.'
  for runtime_var in \
    GSB_LOCAL_ROOT GSB_WORKSPACE GSB_SESSION GSB_AGENT GSB_STATE_DIR \
    GSB_PROJECT_DIR GSB_PROMPTS_DIR GSB_PROFILES_DIR \
    GSB_CONFIG_PATH GSB_MODELS_CONFIG_PATH GSB_CONFIG_SOURCE GSB_CONFIG_PROFILE \
    GSB_PROTOCOL_FILE GSB_ROLE_ROSTER GSB_LAYOUT_FILE GSB_SESSION_ENV_FILE \
    GSB_SESSION_METADATA_FILE GSB_ROLES GSB_WATCHDOG_ENABLED ZELLIJ_SOCKET_DIR \
    GSB_FULL_ACCESS GSB_PERMISSION_PROFILE GSB_PERMISSION_MODE \
    GSB_CODEX_APPROVAL GSB_CODEX_SANDBOX GSB_KIMI_PERMISSION; do
    write_session_export "$runtime_var"
  done
  for optional_var in GSB_MODEL GSB_EFFORT GSB_KIMI_MODEL GSB_KIMI_HOST_CWD; do
    if [[ -n "${!optional_var:-}" ]]; then
      write_session_export "$optional_var"
    else
      printf 'unset %s\n' "$optional_var"
    fi
  done
  for role in "${ROLES[@]}"; do
    role_var="$(role_env_var "$role")"
    write_session_export "$role_var"
    role_model_var="$(role_model_env_var "$role")"
    if [[ -n "${!role_model_var:-}" ]]; then
      write_session_export "$role_model_var"
    else
      printf 'unset %s\n' "$role_model_var"
    fi
  done
} > "$session_env_tmp"
chmod 600 "$session_env_tmp"
mv "$session_env_tmp" "$GSB_SESSION_ENV_FILE"

node "$ROOT_DIR/bin/session-meta.mjs" write "$GSB_SESSION_METADATA_FILE"

roster_tmp="$GSB_STATE_DIR/.ROLES.md.$$.tmp"
{
  printf '%s\n' '# GSB Active Role Roster' '' "Session: $SESSION" "Workspace: $WORKSPACE" '' '## Active roles' ''
  for ((role_index = 0; role_index < ${#ROLES[@]}; role_index++)); do
    role_model_var="$(role_model_env_var "${ROLES[$role_index]}")"
    printf -- '- %s: `%s` (model: `%s`, prompt: `%s`)\n' \
      "${ROLES[$role_index]}" \
      "${AGENT_SPECS[$role_index]}" \
      "${!role_model_var:-agent-default}" \
      "$(prompt_for_role "${ROLES[$role_index]}")"
  done
  printf '%s\n' '' 'Only roles in this roster are active. Removing a role from agents.conf and rebuilding removes its pane and routing authority while retaining historical files.'
} > "$roster_tmp"
chmod 600 "$roster_tmp"
mv "$roster_tmp" "$GSB_ROLE_ROSTER"

if [[ ! -f "$GSB_STATE_DIR/TASK.md" ]]; then
  {
    printf '%s\n' \
      '# GSB Shared Task Board' \
      '' \
      "Workspace: $WORKSPACE" \
      "Session: $SESSION" \
      '' \
      '## Goal' \
      '' \
      '_Hub fills this section after receiving the user goal._' \
      '' \
      '## Assignments' \
      ''
    for role in "${ROLES[@]}"; do
      [[ "$role" == hub ]] && continue
      printf -- '- %s: waiting\n' "$role"
    done
    printf '%s\n' '' '## Decisions' '' '_Hub records accepted decisions here._'
  } > "$GSB_STATE_DIR/TASK.md"
fi

for contract_role in "${ROLES[@]}"; do
  [[ "$contract_role" == hub ]] && continue
  contract_file="$GSB_STATE_DIR/contracts/$contract_role.md"
  if [[ ! -f "$contract_file" ]]; then
    printf '%s\n' \
      "# Dispatch Contract: $contract_role" \
      '' \
      "Contract ID: $SESSION-$contract_role" \
      'Status: waiting' \
      '' \
      '## Objective' \
      '' \
      '_Hub replaces this with one observable outcome and relevant background._' \
      '' \
      '## Scope' \
      '' \
      '- Allowed: repository inspection, safe diagnostics, and the role report.' \
      '- Write allow-list: none by default. Hub must list exact paths to grant scoped mutation.' \
      '- Do not touch: commits, pushes, deployments, unrelated files, or scope outside this contract.' \
      '' \
      '## Validation' \
      '' \
      '- Done when: Hub-defined checks are satisfied with current-run evidence.' \
      '- Proof: record exact commands, relevant output, and affected paths in the role report.' \
      '' \
      '## Stop conditions' \
      '' \
      '- Stop and send a blocker if required access is missing, scope must expand, write ownership conflicts, or evidence conflicts with the objective.' \
      '' \
      '## Reply route' \
      '' \
      "- Send progress: node \"$ROOT_DIR/bin/relay.mjs\" send hub progress '{\"summary\":\"...\"}'" \
      "- Send blocker: node \"$ROOT_DIR/bin/relay.mjs\" send hub blocker '{\"question\":\"...\",\"missing\":\"...\",\"safe_fallback\":\"no_safe_fallback\"}'" \
      "- Send final result: node \"$ROOT_DIR/bin/relay.mjs\" send hub result '{\"summary\":\"...\",\"report\":\"reports/$contract_role.md\",\"proof\":\"...\",\"caveats\":[]}'" \
      "- After sending, wake Hub: bash \"$ROOT_DIR/bin/nudge\" hub" \
      > "$contract_file"
  fi
done

node "$ROOT_DIR/bin/render-layout.mjs" "$GSB_LAYOUT_FILE" "$SESSION" "${ROLES[@]}"

if [[ "$PARENT_ENV_SANITIZED" == true ]]; then
  printf 'Sanitized inherited Claude child-session markers before starting Zellij.\n'
fi
if [[ "$FULL_ACCESS" == true ]]; then
  printf 'WARNING: full-access enabled; built-in agents will run without normal approval or sandbox protections.\n' >&2
fi

if [[ "$REBUILD" == true ]] && printf '%s\n' "$SESSION_LIST" | awk -v session="$SESSION" '$1 == session { found = 1 } END { exit(found ? 0 : 1) }'; then
  printf 'Rebuilding Zellij session with current configuration: %s\n' "$SESSION"
  zellij delete-session --force "$SESSION" >/dev/null
elif printf '%s\n' "$SESSION_LIST" | awk -v session="$SESSION" '$1 == session && /EXITED/ { found = 1 } END { exit(found ? 0 : 1) }'; then
  printf 'Rebuilding dead Zellij session: %s\n' "$SESSION"
  zellij delete-session "$SESSION" >/dev/null
fi

stop_watchdog() {
  watchdog_pidfile="$GSB_STATE_DIR/watchdog.pid"
  if [[ -f "$watchdog_pidfile" ]]; then
    previous_watchdog="$(cat "$watchdog_pidfile" 2>/dev/null || true)"
    if [[ -n "$previous_watchdog" ]] && kill -0 "$previous_watchdog" 2>/dev/null; then
      kill "$previous_watchdog" 2>/dev/null || true
    fi
  fi
  cleanup_watchdog_artifacts "$GSB_STATE_DIR"
}

start_watchdog() {
  [[ "${GSB_WATCHDOG_ENABLED:-true}" == true ]] || return 0
  launch_watchdog_from_session "$GSB_STATE_DIR" "$SESSION"
}

# The watchdog must not query a session while Zellij is still constructing it.
# Zellij 0.44.3 can also hang or panic its per-session server during rapid
# kill/recreate cycles. Bound each create attempt, probe whether the server
# actually became live, and retry once instead of hanging the caller forever.
stop_watchdog

create_zellij_session() {
  node "$ROOT_DIR/bin/run-with-timeout.mjs" 15000 \
    zellij --layout "$GSB_LAYOUT_FILE" attach \
      --create-background "$SESSION" \
      options \
      --default-cwd "$WORKSPACE" \
      --disable-session-metadata true \
      --on-force-close detach \
      --session-serialization false \
      --show-startup-tips false
}

session_created=false
for create_attempt in 1 2; do
  create_status=0
  create_zellij_session || create_status=$?
  if zellij list-sessions --no-formatting 2>/dev/null | \
      awk -v session="$SESSION" '$1 == session && !/EXITED/ { found = 1 } END { exit(found ? 0 : 1) }'; then
    session_created=true
    break
  fi
  if [[ "$create_attempt" -lt 2 ]]; then
    printf 'Zellij create attempt %s failed (status %s); retrying once.\n' "$create_attempt" "$create_status" >&2
    sleep 1
  fi
done
if [[ "$session_created" != true ]]; then
  printf 'Failed to create Zellij session %s. Inspect %s for server details.\n' \
    "$SESSION" "$ZELLIJ_SOCKET_DIR/zellij-log/zellij.log" >&2
  exit 1
fi

session_ready=false
for _ in {1..50}; do
  if zellij list-sessions --no-formatting 2>/dev/null | \
      awk -v session="$SESSION" '$1 == session { found = 1 } END { exit(found ? 0 : 1) }'; then
    session_ready=true
    break
  fi
  sleep 0.1
done
if [[ "$session_ready" != true ]]; then
  printf 'Zellij did not publish session %s after creation. Watchdog was not started.\n' "$SESSION" >&2
  exit 1
fi

start_watchdog

if [[ "$BACKGROUND" == true ]]; then
  printf 'Zellij session created in background: %s\n' "$SESSION"
  exit 0
fi

exec zellij attach "$SESSION"
